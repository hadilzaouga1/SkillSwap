<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Pour ouvrir l'application Calendrier (Intent implicite), Android 11+ demande de déclarer ce qu'on cherche -->
    <queries>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="text/plain" /></intent>
    </queries>

    <application
        android:name=".SkillSwapApp"
        android:allowBackup="false"
        android:label="SkillSwap"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkillSwap">

        <!-- Écran de démarrage -->
        <activity android:name=".ui.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écrans internes : exported=false (seule l'application peut les lancer) -->
        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.SkillDetailActivity" android:exported="false" />
        <activity android:name=".ui.SeanceActivity" android:exported="false" />
        <activity android:name=".ui.AvisActivity" android:exported="false" />

        <!-- Assistant : accessible aussi depuis les autres applications (menu Partager) -->
        <activity android:name=".ui.AssistantActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Permet d'ouvrir un PDF téléchargé dans l'application de lecture du téléphone -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
