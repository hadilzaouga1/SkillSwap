PORT=8090
DB_CLIENT=better-sqlite3
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillswap_ai
EXCHANGE_SERVICE_URL=http://localhost:8082
SKILL_SERVICE_URL=http://localhost:8084
# Optionnel : sans clé, l'agent fonctionne en mode local (réponses prédéfinies).
# Avec une clé Anthropic, il utilise Claude. NE JAMAIS COMMITTER la clé.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_RATE_LIMIT=30
